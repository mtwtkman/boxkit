#!/usr/bin/env bash
set -euo pipefail

die() { printf 'boxkit: %s\n' "$*" >&2; exit 1; }
warn() { printf 'boxkit: warning: %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
trim() { local x="$1"; x="${x#"${x%%[![:space:]]*}"}"; x="${x%"${x##*[![:space:]]}"}"; printf '%s' "$x"; }
script_path() { readlink -f -- "${BASH_SOURCE[0]}"; }
project_dir() { cd -- "$(dirname -- "$(script_path)")" && pwd -P; }
valid_bool() { [[ "$1" == true || "$1" == false ]] || die "expected true/false, got $1"; }
usage() {
  cat <<'HELP'
Usage: boxkit init | enter|e [-r] | exec COMMAND... | stop|s | rm | list|ls
  init             Generate boxkit.ini and ./box (never overwrite existing files).
  enter, e [-r]    Create/start and enter, -r explicitly recreates.
  exec COMMAND...  Run a command in an existing running container.
  stop, s          Stop the container.
  rm               Remove the container (preserves project HOME).
  list, ls         Show boxkit-managed containers.
Run ./box from a project after initialization.
HELP
}
create_default() {
  local dst="$1" name
  need readlink
  mkdir -p -- "$dst"
  [[ ! -e "$dst/boxkit.ini" && ! -L "$dst/boxkit.ini" ]] || die "refusing to overwrite $dst/boxkit.ini"
  [[ ! -e "$dst/box" && ! -L "$dst/box" ]] || die "refusing to overwrite $dst/box"
  name="$(basename "$dst")-dev"
  cat > "$dst/boxkit.ini" <<EOF
[container]
name = $name
engine = podman
image = docker.io/library/archlinux:latest
home = .boxkit/home

[integration]
ssh_agent = true
wayland = true
dbus_session = true
gpu = false

[network]
mode = private
# publish = 8080:8080

[mounts]
# mount = ./data|/data|rw
# mount = ~/.config/nvim|/home/dev/.config/nvim|ro

[packages]
additional = wl-clipboard fd fzf git neovim ripgrep make gcc

[setup]
# hook = echo 'Initial setup'

[engine_args]
# create_arg = --hostname=haskell-dev
# create_arg = --env=EXAMPLE=value
EOF
  # Self-copy avoids the previous nested heredoc quoting problem.
  cp -- "$(script_path)" "$dst/box"
  chmod +x "$dst/box"
  mkdir -p -- "$dst/.boxkit/state" "$dst/.boxkit/home"
  printf 'Created %s/boxkit.ini and %s/box\n' "$dst" "$dst"
}
NAME='' ENGINE=podman IMAGE='' HOME_PATH=.boxkit/home
SSH_AGENT=true WAYLAND=true DBUS_SESSION=true GPU=false NETWORK=private
declare -a MOUNTS=() PORTS=() PACKAGES=() HOOKS=() CREATE_ARGS=()
load_config() {
  local file="$ROOT/boxkit.ini" section='' line key value
  [[ -f "$file" ]] || die "missing $file; run boxkit init"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "$line")"
    [[ -z "$line" || "$line" == \#* || "$line" == \;* ]] && continue
    if [[ "$line" =~ ^\[([a-z_]+)\]$ ]]; then section="${BASH_REMATCH[1]}"; continue; fi
    [[ "$line" == *=* ]] || die "invalid INI line: $line"
    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"
    case "$section.$key" in
      container.name) NAME="$value";;
      container.engine) ENGINE="$value";;
      container.image) IMAGE="$value";;
      container.home) HOME_PATH="$value";;
      integration.ssh_agent) SSH_AGENT="$value";;
      integration.wayland) WAYLAND="$value";;
      integration.dbus_session) DBUS_SESSION="$value";;
      integration.gpu) GPU="$value";;
      network.mode) NETWORK="$value";;
      network.publish) PORTS+=("$value");;
      mounts.mount) MOUNTS+=("$value");;
      packages.additional)
        local -a words=()
        read -r -a words <<< "$value"
        PACKAGES+=("${words[@]}")
        ;;
      setup.hook) [[ -n "$value" ]] || die "empty setup hook"; HOOKS+=("$value");;
      engine_args.create_arg)
        # Only option-form tokens; never evaluate shell code from configuration.
        [[ "$value" =~ ^--[a-zA-Z][a-zA-Z0-9-]*(=.*)?$ ]] || die "create_arg must be one long option (use --option=value)"
        CREATE_ARGS+=("$value")
        ;;
      *) die "unknown setting $section.$key";;
    esac
  done < "$file"
  [[ "$NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || die "invalid container name"
  [[ -n "$IMAGE" ]] || die "container.image required"
  [[ "$ENGINE" == podman ]] || die "engine '$ENGINE' not supported yet (currently: podman)"
  valid_bool "$SSH_AGENT"; valid_bool "$WAYLAND"; valid_bool "$DBUS_SESSION"; valid_bool "$GPU"
  local pkg
  for pkg in "${PACKAGES[@]}"; do
    [[ "$pkg" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+_@:-]*$ ]] || die "invalid package name: $pkg"
  done
  [[ "$NETWORK" == private || "$NETWORK" == none ]] || die "network.mode must be private or none"
  [[ "$HOME_PATH" != /* && "$HOME_PATH" != *..* ]] || die "container.home must be a relative path without '..'"
  LOCAL_HOME="$ROOT/$HOME_PATH"
  mkdir -p -- "$LOCAL_HOME" "$ROOT/.boxkit/state" "$LOCAL_HOME/.boxkit-runtime"
  chmod 700 "$LOCAL_HOME/.boxkit-runtime"
  STATE_DIR="$ROOT/.boxkit/state"
}
resolve_source() {
  local x="$1"
  case "$x" in
    '~') x="$HOST_HOME";;
    '~/'*) x="$HOST_HOME/${x:2}";;
    /*) ;;
    *) x="$ROOT/$x";;
  esac
  readlink -m -- "$x"
}
validate_mount() {
  local item="$1" source destination mode extra
  IFS='|' read -r source destination mode extra <<< "$item"
  [[ -n "$source" && "$destination" == /* && -z "$extra" ]] || die "mount must be source|/destination|ro-or-rw"
  [[ "$mode" == ro || "$mode" == rw ]] || die "mount mode must be ro or rw"
  [[ "$destination" != / && "$destination" != /workspace && "$destination" != /home/dev && "$destination" != /run && "$destination" != /proc ]] || die "reserved mount destination: $destination"
  source="$(resolve_source "$source")"
  [[ -e "$source" ]] || die "mount source does not exist: $source"
  MOUNT_ARGS+=(--mount "type=bind,src=$source,dst=$destination,$([ "$mode" = ro ] && printf readonly || printf rw)")
}
normalize_host_session_bus() {
  # Rootless Podman/crun may use sd-bus to reach the host's systemd user
  # manager. A stale or noncanonical address inherited from the login shell
  # can make container start fail before any container-side D-Bus configuration
  # takes effect. Fix only this script's environment and child processes.
  local runtime_dir="${XDG_RUNTIME_DIR:-}" canonical
  [[ -n "$runtime_dir" && -S "$runtime_dir/bus" ]] || return 0
  canonical="unix:path=$runtime_dir/bus"
  if [[ "${DBUS_SESSION_BUS_ADDRESS:-}" != "$canonical" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="$canonical"
  fi
}
detect_integrations() {
  local socket='' wd='' rt=''
  AGENT_SOCKET='' WAYLAND_SOCKET='' DBUS_SOCKET=''
  if [[ "$SSH_AGENT" == true ]]; then
    socket="${BOX_SSH_AGENT_SOCKET:-${SSH_AUTH_SOCK:-}}"
    if [[ -n "$socket" && -S "$socket" ]]; then
      AGENT_SOCKET="$(readlink -f -- "$socket")"
    else
      warn "SSH agent unavailable; forwarding disabled for this container instance"
    fi
  fi
  if [[ "$WAYLAND" == true ]]; then
    wd="${WAYLAND_DISPLAY:-}"
    rt="${XDG_RUNTIME_DIR:-}"
    if [[ "$wd" == /* ]]; then socket="$wd"; else socket="$rt/$wd"; fi
    [[ -n "$wd" && -S "$socket" ]] || die "Wayland enabled but socket unavailable: $socket"
    WAYLAND_SOCKET="$(readlink -f -- "$socket")"
  fi
  if [[ "$DBUS_SESSION" == true ]]; then
    # The session bus usually lives in the host XDG runtime directory. An
    # explicit unix:path= address may override that location.
    local bus="${XDG_RUNTIME_DIR:-}/bus" address="${DBUS_SESSION_BUS_ADDRESS:-}"
    if [[ "$address" == unix:path=* ]]; then
      local candidate="${address#unix:path=}"
      candidate="${candidate%%,*}"
      if [[ "$candidate" == /* && -S "$candidate" ]]; then bus="$candidate"; fi
    fi
    if [[ -S "$bus" ]]; then
      DBUS_SOCKET="$(readlink -f -- "$bus")"
    else
      warn "session D-Bus socket unavailable; D-Bus integration disabled for this container instance"
    fi
  fi
}
fingerprint() {
  local path
  { cat "$ROOT/boxkit.ini"
    printf '\n%s\n%s\n%s\n' "$AGENT_SOCKET" "$WAYLAND_SOCKET" "$DBUS_SOCKET"
    for path in "$AGENT_SOCKET" "$WAYLAND_SOCKET" "$DBUS_SOCKET"; do
      if [[ -n "$path" ]]; then stat -Lc '%d:%i' -- "$path"; fi
    done
  } | sha256sum | awk '{print $1}'
}
container_id() {
  podman container inspect --format '{{.Id}}' "$NAME" 2>/dev/null || :
}
container_running() {
  [[ "$(podman container inspect --format '{{.State.Running}}' "$NAME" 2>/dev/null || :)" == true ]]
}
make_container() {
  local item mapping source destination mode proto hostport containerport port extra
  local -a args=(
    create --name "$NAME" --label io.boxkit.managed=true
    --userns=keep-id --user "$(id -u):$(id -g)"
    --workdir /workspace
    --env HOME=/home/dev
    --env SHELL=/bin/bash
    --env "BOXKIT_NAME=${BOXKIT_NAME:-$NAME}"
    --env XDG_CONFIG_HOME=/home/dev/.config
    --env XDG_CACHE_HOME=/home/dev/.cache
    --env XDG_DATA_HOME=/home/dev/.local/share
    --env XDG_STATE_HOME=/home/dev/.local/state
    # sudo needs setuid elevation inside the rootless user namespace.
    --mount "type=bind,src=$ROOT,dst=/workspace,rw"
    --mount "type=bind,src=$LOCAL_HOME,dst=/home/dev,rw"
  )
  local -a MOUNT_ARGS=()
  for item in "${MOUNTS[@]}"; do validate_mount "$item"; done
  args+=("${MOUNT_ARGS[@]}")
  if [[ "$NETWORK" == none ]]; then args+=(--network none); fi
  for port in "${PORTS[@]}"; do
    [[ "$NETWORK" == private ]] || die "ports require network.mode=private"
    [[ "$port" =~ ^[0-9]+:[0-9]+$ ]] || die "publish must be host-port:container-port"
    args+=(-p "127.0.0.1:$port")
  done
  if [[ -n "$AGENT_SOCKET" ]]; then
    args+=(--mount "type=bind,src=$AGENT_SOCKET,dst=/home/dev/.boxkit-runtime/ssh-agent.sock,rw"
           --env SSH_AUTH_SOCK=/home/dev/.boxkit-runtime/ssh-agent.sock)
  fi
  if [[ -n "$WAYLAND_SOCKET" ]]; then
    args+=(--mount "type=bind,src=$WAYLAND_SOCKET,dst=/home/dev/.boxkit-runtime/wayland-0,rw"
           --env WAYLAND_DISPLAY=wayland-0)
  fi
  if [[ -n "$DBUS_SOCKET" ]]; then
    args+=(--mount "type=bind,src=$DBUS_SOCKET,dst=/home/dev/.boxkit-runtime/bus,rw"
           --env DBUS_SESSION_BUS_ADDRESS=unix:path=/home/dev/.boxkit-runtime/bus)
  else
    # Never leave a stale host address pointing to an inaccessible socket.
    args+=(--env DBUS_SESSION_BUS_ADDRESS=)
  fi
  if [[ -n "$WAYLAND_SOCKET" || -n "$DBUS_SOCKET" ]]; then
    args+=(--env XDG_RUNTIME_DIR=/home/dev/.boxkit-runtime)
  fi
  # Engine-specific escape hatch; applied at creation, before image/command.
  # A changed argument changes the config fingerprint and requires recreation.
  args+=("${CREATE_ARGS[@]}")
  if [[ "$GPU" == true ]]; then
    [[ -d /dev/dri ]] || die "GPU enabled but /dev/dri missing"
    args+=(--device /dev/dri:/dev/dri --group-add keep-groups)
  fi
  podman "${args[@]}" --entrypoint /bin/sh "$IMAGE" -c 'while :; do sleep 3600; done' >/dev/null
  fingerprint > "$STATE_DIR/runtime-fingerprint"
}
ensure_container() {
  local recreate="$1" id actual expected
  detect_integrations
  expected="$(fingerprint)"
  id="$(container_id)"
  if [[ "$recreate" == true && -n "$id" ]]; then
    podman rm -f "$NAME" >/dev/null
    id=''
  fi
  if [[ -n "$id" ]]; then
    actual="$(cat "$STATE_DIR/runtime-fingerprint" 2>/dev/null || :)"
    if [[ "$actual" != "$expected" ]]; then
      die "container configuration or socket changed; run './box enter -r' to recreate (HOME preserved)"
    fi
  else
    make_container
  fi
  if ! container_running; then podman start "$NAME" >/dev/null; fi
}
bootstrap_packages() {
  local bootstrap
  bootstrap='set -e
if command -v apt-get >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq bash git curl ca-certificates openssh-client sudo "$@"
elif command -v apk >/dev/null 2>&1; then
  apk add --no-cache bash git curl ca-certificates openssh-client sudo "$@"
elif command -v dnf >/dev/null 2>&1; then
  dnf install -y bash git curl ca-certificates openssh-clients sudo "$@"
elif command -v pacman >/dev/null 2>&1; then
  # Synchronize the whole Arch system before installing packages; -Sy alone
  # creates unsupported partial upgrades against an older image.
  pacman -Syu --noconfirm --needed bash git curl ca-certificates openssh sudo "$@"
else
  echo "Unsupported image package manager; supply bash git curl and ssh manually" >&2
  exit 1
fi'
  podman exec --user 0 "$NAME" /bin/sh -c "$bootstrap" boxkit-bootstrap "${PACKAGES[@]}"
  local account_setup
  account_setup='set -e
uid="$1"
gid="$2"
if ! grep -q "^[^:]*:[^:]*:$gid:" /etc/group; then
  printf "boxdev:x:%s:\\n" "$gid" >> /etc/group
fi
if ! grep -q "^[^:]*:[^:]*:$uid:" /etc/passwd; then
  printf "boxdev:x:%s:%s::/home/dev:/bin/bash\\n" "$uid" "$gid" >> /etc/passwd
fi
username=""
while IFS=: read -r name _ entry_uid _; do
  if [ "$entry_uid" = "$uid" ]; then username="$name"; break; fi
done < /etc/passwd
[ -n "$username" ] || { echo "boxkit: cannot resolve container user" >&2; exit 1; }
# Only grant passwordless sudo to the mapped development user.
case "$username" in
  *[!a-zA-Z0-9_-]*|"") echo "boxkit: unsafe container user name" >&2; exit 1 ;;
esac
mkdir -p /etc/sudoers.d
printf "%s ALL=(ALL) NOPASSWD: ALL\\n" "$username" > /etc/sudoers.d/boxkit
chmod 0440 /etc/sudoers.d/boxkit
'
  podman exec --user 0 "$NAME" /bin/sh -c "$account_setup" boxkit-account "$(id -u)" "$(id -g)"
}
generate_bashrc_preset() {
  local rc=/home/dev/.bashrc
  # Preserve existing user configuration, including GHCup additions.
  [[ ! -e "$rc" && ! -L "$rc" ]] || return 0
  cat > "$rc" <<'RC'
# Development shell preset generated by boxkit.
export BOX_INITIALIZED=1
case $- in *i*) ;; *) return ;; esac

alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alF'
if command -v nvim >/dev/null 2>&1; then
  alias vim='nvim'
fi

for completion in \
  /usr/share/bash-completion/bash_completion \
  /usr/share/git/completion/git-completion.bash \
  /usr/share/git/completion/git-prompt.sh; do
  [[ -f "$completion" ]] && source "$completion"
done

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

if command -v rg >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='rg --files --no-ignore --hidden --follow -g "!{.git,node_modules}/*" 2>/dev/null'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi
export FZF_DEFAULT_OPTS="
--reverse
--extended
--multi
--inline-info
--prompt='fzf>'
--ansi
--preview='cat {}'
--bind='ctrl-f:page-down,ctrl-b:page-up,ctrl-a:first,ctrl-z:last'
--color='bg:#000000,fg:#ffffff,bg+:#c0c0c0,fg+:#ffffff,hl:#99ccff,hl+:#3399ff'
"
if command -v nvim >/dev/null 2>&1; then
  FZF_DEFAULT_OPTS+="
--bind='ctrl-v:become(nvim {})'"
fi
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi

export GIT_PS1_SHOWCOLORHINTS=true
git_prompt=''
if declare -F __git_ps1 >/dev/null 2>&1; then
  git_prompt='$(__git_ps1 " (%s)")'
fi
box_name="${BOXKIT_NAME:-${HOSTNAME:-box}}"
PS1='\w'"$git_prompt"' -  : \[\e[33m\]'"$box_name"'\[\e[0m\]\n\$ '
RC
}
init_inside() {
  local marker=/workspace/.boxkit/state/initialized setup=/workspace/box_setup.sh
  local instance="${BOX_CONTAINER_INSTANCE:-}" provisioner="${BOX_PROVISIONER:-none}"
  [[ -n "$instance" ]] || die "missing BOX_CONTAINER_INSTANCE"
  case "$provisioner" in
    none) ;;
    mi)
      if [[ -n "${MI_REPO_PATH:-}" ]]; then
        [[ -f "$MI_REPO_PATH/mi" ]] || die "MI_REPO_PATH is not accessible inside the container"
        MI_PROFILE=container bash "$MI_REPO_PATH/mi" deploy
      else
        local temp
        temp="$(mktemp)"
        curl -fsSL "${BOX_MI_SETUP_URL:-https://raw.githubusercontent.com/mtwtkman/mi/main/setup}" -o "$temp" || { rm -f "$temp"; return 1; }
        MI_PROFILE=container bash "$temp" || { rm -f "$temp"; return 1; }
        rm -f "$temp"
      fi
      ;;
    *) die "unsupported BOX_PROVISIONER: $provisioner";;
  esac
  generate_bashrc_preset
  # Run user-defined first-initialization hooks (not on every shell entry).
  # Each hook has its own process. Persistent environment belongs in
  # container creation flags, not "export" in a setup hook.
  local hook
  for hook in "${HOOKS[@]}"; do
    (cd /workspace && bash -c "$hook")
  done
  if [[ -e "$setup" || -L "$setup" ]]; then
    [[ -f "$setup" ]] || die "invalid box_setup.sh"
    (cd /workspace && bash "$setup")
  fi
  printf '%s\n' "$instance" > "$marker"
}
initialize_if_needed() {
  local id marker="$STATE_DIR/initialized" provisioner answer
  id="$(container_id)"
  [[ -n "$id" ]] || die "container missing"
  if [[ -f "$marker" && "$(cat "$marker")" == "$id" ]]; then return; fi
  provisioner="${BOX_PROVISIONER:-}"
  if [[ -z "$provisioner" ]]; then
    [[ -t 0 ]] || die "first enter requires BOX_PROVISIONER=mi|none without a terminal"
    printf 'Provision this container with Mi? [y/N] ' >&2
    IFS= read -r answer
    if [[ "$answer" == y || "$answer" == Y ]]; then provisioner=mi; else provisioner=none; fi
  fi
  [[ "$provisioner" == mi || "$provisioner" == none ]] || die "invalid BOX_PROVISIONER"
  bootstrap_packages
  # Never mark initialization complete on failure.
  podman exec --user "$(id -u):$(id -g)" \
    --env "BOX_CONTAINER_INSTANCE=$id" --env "BOX_PROVISIONER=$provisioner" \
    --env "MI_REPO_PATH=${MI_REPO_PATH:-}" \
    --env "BOX_MI_SETUP_URL=${BOX_MI_SETUP_URL:-}" \
    "$NAME" /bin/bash /workspace/box _init
  [[ -f "$marker" && "$(cat "$marker")" == "$id" ]] || die "container initialization incomplete"
}
main() {
  local command="${1:-}" recreate=false
  if [[ "$command" == init ]]; then
    [[ "$#" -eq 1 ]] || die "usage: boxkit init"
    create_default "$PWD"
    return
  fi
  case "$command" in
    -h|--help|'') usage; return;;
  esac
  ROOT="$(project_dir)"
  HOST_HOME="$HOME"
  if [[ "$command" == _init ]]; then load_config; init_inside; return; fi
  normalize_host_session_bus
  load_config
  need podman
  case "$command" in
    enter|e)
      [[ "$#" -le 2 ]] || die "usage: ./box enter [-r]"
      [[ "$#" -eq 1 || "${2:-}" == -r ]] || die "usage: ./box enter [-r]"
      [[ "${2:-}" == -r ]] && recreate=true
      ensure_container "$recreate"
      initialize_if_needed
      exec podman exec -it --user "$(id -u):$(id -g)" --workdir /workspace --env SHELL=/bin/bash "$NAME" /bin/bash -i
      ;;
    exec)
      shift
      [[ "$#" -gt 0 ]] || die "usage: ./box exec COMMAND..."
      container_running || die "container not running; use ./box enter"
      local -a tty_opts=(-i)
      if [[ -t 0 && -t 1 ]]; then tty_opts+=(-t); fi
      exec podman exec "${tty_opts[@]}" --user "$(id -u):$(id -g)" "$NAME" "$@"
      ;;
    stop|s)
      if [[ -n "$(container_id)" ]] && container_running; then podman stop "$NAME"; fi
      ;;
    rm)
      if [[ -n "$(container_id)" ]]; then podman rm -f "$NAME"; fi
      ;;
    list|ls)
      podman ps -a --filter label=io.boxkit.managed=true --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
      ;;
    *) die "unknown command $command";;
  esac
}
main "$@"
