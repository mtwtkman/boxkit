#!/bin/bash
command -v distrobox >/dev/null 2>&1 || { echo "distrobox not found" >&2; exit 1; }
if [ -n "${BOX_INIT_POST_HOOK:-}" ]; then echo "BOX_INIT_POST_HOOK is disabled; use a reviewed setup script." >&2; exit 2; fi

function usage
{
  if [ "${README_GEN}" ]; then
    entrypoint_default='<Project root path>'
  else
    entrypoint_default="$(pwd)"
  fi
  echo "boxkit is a helper tool for building development environment by using distrobox."
  echo ""
  echo "USAGE:"
  echo -e "\t[OPTIONS] ./boxkit"
  echo ""
  echo "OPTIONS:"
  echo -e "\tDISTROBOX_CONTAINER_NAME"
  echo -e "\t\tA name of your development container created by distrobox."
  echo -e "\t\tIf it wan't set then boxkit prompt will ask you it."
  echo ""
  echo -e "\tBOX_ENTRYPOINT_NAME"
  echo -e "\t\tThe entrypoint of result objects created by boxkit."
  echo -e "\t\tThis value is regarded as relative path under from a project root."
  echo -e "\t\tdefault: ${entrypoint_default}"
  echo ""
  echo -e "\tDISTROBOX_HOME_NAME"
  echo -e "\t\tA name of custom home directory name for your development container."
  echo -e "\t\tdefault: \${BOX_ENTRYPOINT_NAME}/.distrobox/home"
  echo ""
  echo -e "\tBOX_SCRIPT_NAME"
  echo -e "\t\tThe script name of the thin wrapper for distrobox."
  echo -e "\t\tdefault: \${BOX_ENTRYPOINT_NAME}/box"
  echo ""
  echo -e "\tDISTROBOX_IMAGE_NAME"
  echo -e "\t\tWhat image for creating your development container image."
  echo -e "\t\tdefault: Up to your distrobox config"
  echo ""
  echo -e "\tBOX_SSH_AGENT_SOCKET"
  echo -e "\t\tOptional stable absolute path to a host ssh-agent UNIX socket."
  echo -e "\t\tWhen set, bind-mount it read-write into the container and set SSH_AUTH_SOCK."
  echo -e "\t\tThe socket must exist when generating the manifest."
  echo ""
  echo -e "\tBOX_INIT_POST_HOOK"
  echo -e "\t\tColon separated commands after box initialization."
  echo -e "\t\tYou can pass any commands like BOX_INIT_POST_HOOK='ls;pwd;'."
  echo -e "\t\tThis options' value elements are permitted of combination of '<command>' and '<prefix>:<value>'."
  echo -e "\t\\tThere are two types <prefix> , 'r' or 'l'. Detail is below."
  echo -e "\t\t\t- 'r' prefix presents 'remote'. r:<url> retrieve contents using curl from <url> and applies as is as command."
  echo -e "\t\t\t- 'l' prefix presents 'local'. l:<path> retrieve contents from local file <path> and applies as is as command."
  echo -e "\t\t\tFor instance, BOX_INIT_POST_HOOK='ls;pwd;r:https://something/scaffolding/ghcup;l:../setup-mise' means 'After box initialization, I do 'ls', 'pwd', 'Retrieve commands from https://something/scaffolding/ghcup', 'Retrieve from ./setup-mise'."
  echo -e "\t\tdefault: Do nothing"
}

[ ! $# = 0 ] && usage && exit 0

container_name="$(basename $(realpath $(pwd)))-dev"

if [ ! "${DISTROBOX_CONTAINER_NAME}" ]; then
  read -p "Please input name for your development container if you want. (default: ${container_name}) > " user_input_container_name
  [ ! -z "${user_input_container_name}" ] && container_name="${user_input_container_name}"
else
  container_name="${DISTROBOX_CONTAINER_NAME}"
fi

echo -e "Your development container name is \e[33m${container_name}\e[0m"

box_entrypoint_path="$(readlink -f ${BOX_ENTRYPOINT_NAME:-$(pwd)})"
distrobox_manifest_path="${box_entrypoint_path}/distrobox.ini"
home_name="${box_entrypoint_path}/${DISTROBOX_HOME_NAME:-.distrobox/home}"
box_script_name="${BOX_SCRIPT_NAME:-box}"
box_script_path="${box_entrypoint_path}/${box_script_name}"
image_name="${DISTROBOX_IMAGE_NAME}"
ssh_agent_socket="${BOX_SSH_AGENT_SOCKET:-}"
if [ -n "$ssh_agent_socket" ]; then
  if [[ "$ssh_agent_socket" != /* || "$ssh_agent_socket" == *[[:space:]]* || "$ssh_agent_socket" == *:* || "$ssh_agent_socket" == *\"* || "$ssh_agent_socket" == *\\* ]]; then
    echo "BOX_SSH_AGENT_SOCKET must be an absolute path without whitespace, colons or quoting characters." >&2
    exit 2
  fi
  if [ ! -S "$ssh_agent_socket" ]; then
    echo "BOX_SSH_AGENT_SOCKET is not an existing UNIX socket: $ssh_agent_socket" >&2
    exit 2
  fi
fi

box_initialization_post_hook=
if [[ "${BOX_INIT_POST_HOOK}" ]]; then
  IFS=';' read -ra elements <<< "${BOX_INIT_POST_HOOK}"
  for element in "${elements[@]}"; do
    if [[ "$element" =~ ":" ]]; then
      prefix=$(echo "$element" | cut -d':' -f1)
      value=$(echo "$element" | cut -d':' -f2-)
      case "$prefix" in
        "r")
          content=$(curl -s "$value")
          processed_element="$content"
          ;;
        "l")
          if [[ -f "$value" ]]; then
            content=$(cat "$value")
            processed_element="$content"
          else
            echo "Error: File not found at $value"
            exit 1
          fi
          ;;
        *)
          processed_element="$value"
          ;;
      esac
    else
      processed_element="$element"
    fi
    if [[ -n "$box_initialization_post_hook" ]]; then
      box_initialization_post_hook+="\n\t"
    fi
    box_initialization_post_hook+="$processed_element"
  done
fi

function create_with_confirmation
{
  local target=$1
  local target_exists=1
  [ -e "$target" ] && target_exists=0
  yn="y"
  [ "${target_exists}" = "0" ] && { echo "Refusing to overwrite existing $target" >&2; return 1; }

  # Never delete existing container data during scaffolding.

  shift
  "$@"
  echo -e "create \e[33m${target}.\e[0m"
}

function generate_distrobox_manifest
{
  echo "[${container_name}]" > "$distrobox_manifest_path"
  [ "${image_name}" ] && echo $"image=${image_name}" >> "$distrobox_manifest_path"
  if [ -n "$ssh_agent_socket" ]; then
    printf 'additional_flags="--volume %s:/run/boxkit-ssh-agent.sock --env SSH_AUTH_SOCK=/run/boxkit-ssh-agent.sock"\\n' "$ssh_agent_socket" >> "$distrobox_manifest_path"
  fi
  cat <<EOF >> $distrobox_manifest_path
additional_packages="fd fzf git neovim ripgrep make gcc"
home=${home_name}
hostname=distrobox
init_hooks=export XDG_CONFIG_HOME=${home_name}/.config
init_hooks=export XDG_CACHE_HOME=${home_name}/.cache
init_hooks=export XDG_STATE_HOME=${home_name}/.local/state
init_hooks=export XDG_DATA_HOME=${home_name}/.local/share
EOF
}

function generate_box_script
{
cat <<BOX > "$box_script_path"
#!/bin/sh

function show_box_script_usage
{
  echo ""
  echo "${box_script_name} is a thin wrapper to manipulate distrobox handy."
  echo ""
  echo "USAGE:"
  echo -e "\\t./${box_script_name} [COMMAND] [OPTION]"
  echo ""
  echo "COMMANDS:"
  echo -e "\\tenter | e [-r]"
  echo -e "\\t\\tEnter your development container via distrobox. If the continer have not existed, ${script_name} will create it."
  echo -e "\\t\\tYou can pass -r option to recreate the container then ${home_name} will be recreated also."
  echo ""
  echo -e "\\tInitialization runs automatically on first enter"
  echo -e "\\t\\tThe first enter asks whether to provision Mi."

  echo -e "\\\t\\tYou can pass -f option to force initialize again."
  echo ""
  echo -e "\\tstop | s"
  echo -e "\\t\\tStop the development container."
}

[ \$# = 0 ] && show_box_script_usage && exit 0

cmd="\$1"

shift

function prepare_ssh_agent
{
  local socket="\${BOX_SSH_AGENT_SOCKET:-\${SSH_AUTH_SOCK:-}}"
  local marker="${box_entrypoint_path}/.distrobox/ssh-agent-source"
  local existing=0
  distrobox list | grep -F -- "${container_name}" >/dev/null && existing=1
  if [ -z "\$socket" ] || [ ! -S "\$socket" ]; then
    echo "Warning: no active host ssh-agent socket; forwarding disabled." >&2
    if [ "\$existing" = 1 ] && [ -f "\$marker" ]; then
      echo "Existing container was configured for SSH forwarding; check agent availability." >&2
    fi
    return 0
  fi
  case "\$socket" in
    /*) ;;
    *) echo "SSH_AUTH_SOCK must be an absolute path" >&2; return 1 ;;
  esac
  case "\$socket" in
    *[[:space:]]*|*:*|*\\*|*\"*) echo "Unsupported SSH_AUTH_SOCK path" >&2; return 1 ;;
  esac
  if [ "\$existing" = 1 ]; then
    if [ -f "\$marker" ] && [ "\$(cat "\$marker")" != "\$socket" ]; then
      echo "Warning: agent socket changed; recreate container to refresh forwarding." >&2
    elif [ ! -f "\$marker" ]; then
      echo "Warning: existing container may lack SSH forwarding; recreate to enable." >&2
    fi
    return 0
  fi
  mkdir -p "${box_entrypoint_path}/.distrobox"
  # Update only the forwarding entry in the generated manifest.
  sed -i '/^additional_flags="--volume .*:\/run\/boxkit-ssh-agent.sock /d' "${distrobox_manifest_path}"
  printf 'additional_flags="--volume %s:/run/boxkit-ssh-agent.sock --env SSH_AUTH_SOCK=/run/boxkit-ssh-agent.sock"\n' "\$socket" >> "${distrobox_manifest_path}"
  printf '%s\n' "\$socket" > "\$marker"
}

function create_box
{
  [ "\${CONTAINER_ID}" ] && return
  # Preserve the existing container HOME even when recreating the container.
  [ "\$(distrobox list | grep -F -- ${container_name})" ] && distrobox assemble rm --file "$distrobox_manifest_path"
  [ ! "\$(distrobox list | grep -F -- ${container_name})" ] && distrobox assemble create --file "$distrobox_manifest_path"
}

function create_symlink
{
  [ -L "\${2}" ] && return

  [ ! -e "\${1}" ] && echo "Cannot find source path. So do nothing. (\${1})" && return
  ln -s "\${1}" "\${2}"
}

function generate_bashrc
{
  cat <<EOF > "${home_name}/.bashrc"
#!/bin/sh

export BOX_INITIALIZED=1

alias l="ls -CF"
alias la="ls -A"
alias ll="ls -alF"
alias vim="nvim"

source /usr/share/bash-completion//bash_completion
source /usr/share/bash-completion/completions/git
source /usr/share/git/completion/git-completion.bash
source /usr/share/git/completion/git-prompt.sh

export FZF_DEFAULT_COMMAND="rg --files --no-ignore --hidden --follow -g \"!{.git,node_modules}/*\" 2> /dev/null"
export FZF_DEFAULT_OPTS="""
--reverse
--extended
--multi
--inline-info
--prompt='fzf>'
--ansi
--preview='cat {}'
--bind=ctrl-f:page-down,ctrl-b:page-up,'ctrl-v:become(vim {})',ctrl-^:first,ctrl-/:last
--color=bg+:#313244,spinner:#f5e0dc,hl:#f38ba8
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
--color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
"""
export FZF_CTRL_T_COMMAND="\\${FZF_DEFAULT_COMMAND}"

eval "\\\$(fzf --bash)"

export GIT_PS1_SHOWCOLORHINTS=true
ps1_git='\\\$(__git_ps1 " (%s)")'
ps1_distrobox=" : \e[33m\${CONTAINER_ID}\e[0m"
export PS1="\w\\\${ps1_git} - \\\${ps1_distrobox}\n\$ "
EOF
}

function initialize_box
{
  local marker="${box_entrypoint_path}/.distrobox/initialized"
  [ -f "\$marker" ] && return 0
  mkdir -p -- "\${XDG_CONFIG_HOME:-\$HOME/.config}" || return 1

  # Provisioning is explicit; never execute arbitrary post-init hooks.
  case "\${BOX_PROVISIONER:-}" in
    "")
      if [ -n "\${MI_REPO_PATH:-}" ]; then
        echo "MI_REPO_PATH requires BOX_PROVISIONER=mi" >&2
        return 1
      fi
      ;;
    mi)
      if [ -n "\${MI_REPO_PATH:-}" ]; then
        [ -f "\${MI_REPO_PATH}/mi" ] || { echo "MI_REPO_PATH must reference a Mi checkout" >&2; return 1; }
        MI_PROFILE=container bash "\${MI_REPO_PATH}/mi" deploy || return 1
      else
        command -v curl >/dev/null 2>&1 || { echo "Mi provisioning requires curl" >&2; return 1; }
        local setup_file
        setup_file="\$(mktemp)" || return 1
        if ! curl -fsSL "\${BOX_MI_SETUP_URL:-https://raw.githubusercontent.com/mtwtkman/mi/main/setup}" -o "\$setup_file"; then
          rm -f -- "\$setup_file"
          echo "Unable to download Mi setup" >&2
          return 1
        fi
        MI_PROFILE=container bash "\$setup_file"
        local result=\$?
        rm -f -- "\$setup_file"
        [ "\$result" -eq 0 ] || return "\$result"
      fi
      ;;
    *)
      echo "Unsupported BOX_PROVISIONER: \${BOX_PROVISIONER}" >&2
      return 1
      ;;
  esac

  generate_bashrc

  echo "generated ${home_name}/.bashrc"
  mkdir -p -- "${box_entrypoint_path}/.distrobox" || return 1
  touch -- "\$marker" || return 1

  # Arbitrary post-initialization shell execution is intentionally disabled.
}

case "\${cmd}" in
  enter|e)
    [ -n "\${CONTAINER_ID:-}" ] && echo "Already in distrobox container, so do nothing" && exit 0
    marker="${box_entrypoint_path}/.distrobox/initialized"
    if [ ! -f "\$marker" ]; then
      provisioner="\${BOX_PROVISIONER:-}"
      case "\$provisioner" in
        mi) ;;
        none) provisioner="" ;;
        "")
          if [ ! -t 0 ]; then
            echo "First enter requires terminal confirmation or BOX_PROVISIONER=mi|none." >&2
            exit 1
          fi
          printf 'Provision this container with Mi? [y/N] '
          IFS= read -r answer || exit 1
          case "\$answer" in
            y|Y) provisioner=mi ;;
            *) provisioner="" ;;
          esac
          ;;
        *) echo "Unsupported BOX_PROVISIONER: \$provisioner" >&2; exit 1 ;;
      esac
    fi
    prepare_ssh_agent || exit 1
    if [ -z "\$(distrobox list | grep -F -- ${container_name})" ]; then
      create_box || exit 1
    fi
    if [ "\$#" = 1 ] && [ "\$1" = "-r" ]; then
      create_box || exit 1
    fi
    if [ ! -f "\$marker" ]; then
      distrobox enter --no-workdir "${container_name}" -- /usr/bin/env "BOX_PROVISIONER=\$provisioner" /bin/bash "${box_script_path}" _init || exit 1
      if [ ! -f "\$marker" ]; then
        echo "Container initialization did not complete; retry ./box enter." >&2
        exit 1
      fi
    fi
    host_dir="\$(pwd | sed 's/\/run\/host//g')"
    distrobox enter --no-workdir "${container_name}" -- /bin/sh -c "cd \"\${host_dir}\" 2>/dev/null; exec \"\${SHELL:-/bin/bash}\""
    ;;
  _init)
    [ -z "\${CONTAINER_ID:-}" ] && echo "Internal init requires a container." >&2 && exit 1
    initialize_box
    ;;
  init|i)
    echo "Initialization is automatic on first ./box enter." >&2
    exit 1
    ;;
  bashrc|b) generate_bashrc;;
  replace|r) distrobox assemble create --replace --file "${distrobox_manifest_path}";;
  stop|s)
    [ "\${CONTAINER_ID}" ] && exit 0
    [ ! "\$(distrobox list | rg ${container_name})" ] && exit 0
    distrobox stop ${container_name}
    ;;
  *) show_box_script_usage;;
esac
BOX
}

[ ! -d "${box_entrypoint_path}" ] && mkdir -p ${box_entrypoint_path}
mkdir -p -- "$home_name"
create_with_confirmation "$distrobox_manifest_path" generate_distrobox_manifest || exit 1
create_with_confirmation "$box_script_path" generate_box_script || exit 1
chmod +x "$box_script_path"

echo 'Now you can run `./box enter` to start distrobox.'
