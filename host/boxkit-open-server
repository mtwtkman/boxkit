#!/usr/bin/env python3
"""Restricted host-side URL opener for Boxkit containers."""
import json
import os
from pathlib import Path
import socket
import subprocess
from urllib.parse import unquote, urlsplit

runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
directory = Path(runtime) / "boxkit-open"
path = directory / "xdg-open.sock"

def session_environment():
    env = os.environ.copy()
    browser = env.get("BROWSER", "firefox")
    desktop = env.get("DESKTOPAPP", "sway")
    env["BROWSER"] = browser
    for process in Path("/proc").iterdir():
        if not process.name.isdecimal(): continue
        try:
            status = (process / "status").read_text()
            uid = next(x for x in status.splitlines() if x.startswith("Uid:"))
            if int(uid.split()[1]) != os.getuid(): continue
            name = (process / "comm").read_text().strip()
            if name not in (browser, desktop): continue
            for entry in (process / "environ").read_bytes().split(b"\0"):
                if entry.startswith(b"DBUS_SESSION_BUS_ADDRESS="):
                    env["DBUS_SESSION_BUS_ADDRESS"] = entry.split(b"=", 1)[1].decode()
                    return env
        except (OSError, ValueError, StopIteration, UnicodeDecodeError):
            continue
    return env

def handle(conn):
    conn.settimeout(5)
    data = b""
    while not data.endswith(b"\n") and len(data) <= 65536:
        chunk = conn.recv(4096)
        if not chunk: break
        data += chunk
    try:
        if len(data) > 65536 or not data.endswith(b"\n"):
            raise ValueError("invalid request length")
        request = json.loads(data)
        if not isinstance(request, dict) or set(request) != {"url"}:
            raise ValueError("invalid request")
        url = request["url"]
        if not isinstance(url, str) or len(url) > 32768 or any(ord(c) < 32 for c in url):
            raise ValueError("invalid URL")
        parsed = urlsplit(url)
        if parsed.scheme.lower() in ("http", "https"):
            if not parsed.netloc:
                raise ValueError("absolute http(s) URL required")
        elif parsed.scheme.lower() == "file":
            if parsed.netloc not in ("", "localhost") or parsed.query or parsed.fragment:
                raise ValueError("invalid local file URI")
            candidate = Path(unquote(parsed.path))
            if not candidate.is_absolute():
                raise ValueError("absolute file path required")
            resolved = candidate.resolve(strict=True)
            # Roots are host-controlled; never accept allowlist values from clients.
            roots = [Path.home()]
            roots += [Path(p) for p in os.environ.get("BOXKIT_OPEN_FILE_ROOTS", "").split(":") if p]
            if not any(resolved.is_relative_to(root.resolve()) for root in roots):
                raise ValueError("file outside host-approved roots")
            url = resolved.as_uri()
        else:
            raise ValueError("unsupported URI scheme")
        subprocess.Popen(["/usr/bin/xdg-open", url], env=session_environment(),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        reply = {"ok": True}
    except (ValueError, OSError, TypeError) as exc:
        reply = {"ok": False, "error": str(exc)}
    conn.sendall((json.dumps(reply) + "\n").encode())

def main():
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory.chmod(0o700)
    if path.exists() or path.is_symlink():
        probe = socket.socket(socket.AF_UNIX)
        try:
            probe.connect(str(path))
        except ConnectionRefusedError:
            path.unlink()
        else:
            raise SystemExit("boxkit-open: another listener is running")
        finally:
            probe.close()
    with socket.socket(socket.AF_UNIX) as server:
        server.bind(str(path))
        os.chmod(path, 0o600)
        server.listen(16)
        try:
            while True:
                conn, _ = server.accept()
                with conn:
                    try: handle(conn)
                    except (OSError, ValueError): pass
        finally:
            path.unlink(missing_ok=True)

if __name__ == "__main__":
    main()
