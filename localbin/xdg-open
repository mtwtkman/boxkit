#!/bin/sh
# OCI-independent host URL bridge; only HTTP(S) is accepted.
set -eu
[ "$#" -gt 0 ] || { echo 'xdg-open: missing URL' >&2; exit 2; }
exec python3 - "$@" <<'PY'
import json, os, socket, sys
path = os.environ.get("BOXKIT_OPEN_SOCKET", "/home/dev/.boxkit-runtime/open/xdg-open.sock")
for url in sys.argv[1:]:
    if not url.lower().startswith(("https://", "http://")):
        sys.exit("xdg-open: only http(s) URLs are supported")
    payload = (json.dumps({"url": url}) + "\n").encode()
    if len(payload) > 65536:
        sys.exit("xdg-open: URL too long")
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(10)
            sock.connect(path)
            sock.sendall(payload)
            response = b""
            while not response.endswith(b"\n") and len(response) < 4096:
                chunk = sock.recv(4096)
                if not chunk: break
                response += chunk
        result = json.loads(response)
        if not result.get("ok"):
            sys.exit("xdg-open: " + result.get("error", "host rejected URL"))
    except (OSError, ValueError) as exc:
        sys.exit(f"xdg-open: host bridge unavailable: {exc}")
PY
